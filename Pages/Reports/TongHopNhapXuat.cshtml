@page
@model QLVT.Web.Pages.Reports.TongHopNhapXuatModel
@{
    ViewData["Title"] = "Bảng Tổng hợp Nhập Xuất";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" id="exportTongHopNXForm">
    <div class="row">
        @if (User.IsInRole("CongTy"))
        {
            <div class="col-md-3">
                <div class="form-group">
                    <label>Chi nhánh</label>
                    <select name="branch" class="form-control" asp-items="Model.ChiNhanhSelectList" id="branchSelect">
                        <option value="">-- Chọn chi nhánh --</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="branch" value="@Model.CurrentBranch" />
        }

        <div class="col-md-3">
            <div class="form-group">
                <label>Từ ngày</label>
                <input type="date" name="fromDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Now).AddDays(-DateTime.Now.Day + 1).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Đến ngày</label>
                <input type="date" name="toDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-3 align-self-end">
            <div class="form-group">
                <button type="submit" class="btn btn-success">Xuất Excel</button>
            </div>
        </div>
    </div>
</form>

<p class="mt-3">
    <strong>Lưu ý:</strong> Báo cáo này sẽ được xuất trực tiếp ra file Excel. <br />
    - Nếu bạn đăng nhập với quyền <strong>Công ty</strong>, bạn cần chọn một chi nhánh để xem báo cáo. <br />
    - Nếu bạn đăng nhập với quyền <strong>Chi nhánh</strong>, báo cáo sẽ chỉ bao gồm dữ liệu từ chi nhánh của bạn.
</p>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const exportTongHopNXForm = document.getElementById('exportTongHopNXForm');
            if (exportTongHopNXForm) {
                exportTongHopNXForm.addEventListener('submit', function (e) {
                    e.preventDefault(); // Ngăn form submit theo cách thông thường

                    const formData = new FormData(exportTongHopNXForm);
                    const params = new URLSearchParams(formData);
                    window.location.href = `?handler=ExportTongHopNX&${params.toString()}`;
                });
            }
        });
    </script>
}