@page
@model QLVT.Web.Pages.Reports.VatTuModel
@{
    ViewData["Title"] = "Báo cáo Danh mục Vật tư";
}

<h1>@ViewData["Title"]</h1>

<form method="get" id="reportForm">
    <div class="row">
        @if (User.IsInRole("CongTy"))
        {
            <div class="col-md-4">
                <div class="form-group">
                    <label>Chi nhánh</label>
                    <select name="branch" class="form-control" asp-items="Model.ChiNhanhSelectList">
                        <option value="">-- Tất cả chi nhánh --</option>
                    </select>
                </div>
            </div>
        }
        <div class="col-md-4 align-self-end">
            <div class="form-group">
                @if (!string.IsNullOrEmpty(Model.TenChiNhanh))
                {
                    <a class="btn btn-success" asp-page-handler="Export" asp-route-branch="@HttpContext.Request.Query["branch"]">Xuất Excel</a>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.VatTus != null && Model.VatTus.Any())
{
    <h3 class="mt-4">Danh mục vật tư (@Model.TenChiNhanh)</h3>
    <table class="table table-bordered mt-2">
        <thead>
            <tr><th>Mã VT</th><th>Tên vật tư</th><th>Đơn vị tính</th><th>Số lượng tồn</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.VatTus)
            {
                <tr><td>@item.Mavt</td><td>@item.Tenvt</td><td>@item.Dvt</td><td>@item.Soluongton</td></tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const branchSelect = document.querySelector('select[name="branch"]');
            if (branchSelect) {
                branchSelect.addEventListener('change', function () {
                    document.getElementById('reportForm').submit();
                });
            }
        });
    </script>
}