@page
@model QLVT.Web.Pages.Reports.HoatDongNhanVienModel
@{
    ViewData["Title"] = "Báo cáo Hoạt động nhân viên";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" id="exportForm">
    <div class="row">
        @if (User.IsInRole("CongTy"))
        {
            <div class="col-md-3">
                <div class="form-group">
                    <label>Chi nhánh</label>
                    <select name="branch" class="form-control" asp-items="Model.ChiNhanhSelectList" id="branchSelect">
                        <option value="">-- Chọn chi nhánh --</option>
                    </select>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="branch" value="@Model.CurrentBranch" />
        }

        <div class="col-md-3">
            <div class="form-group">
                <label>Nhân viên</label>
                <select name="manv" class="form-control" asp-items="Model.NhanVienSelectList" id="nhanVienSelect">
                    <option value="">-- Chọn nhân viên --</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Từ ngày</label>
                <input type="date" name="fromDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Now).AddDays(-DateTime.Now.Day + 1).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Đến ngày</label>
                <input type="date" name="toDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-2 align-self-end">
            <div class="form-group">
                <button type="submit" class="btn btn-success">Xuất Excel</button>
            </div>
        </div>
    </div>
</form>

<p class="mt-3">
    <strong>Lưu ý:</strong> Báo cáo này sẽ được xuất trực tiếp ra file Excel. <br />
    - Nếu bạn đăng nhập với quyền <strong>Công ty</strong>, bạn cần chọn một chi nhánh để xem danh sách nhân viên tương ứng. <br />
    - Nếu bạn đăng nhập với quyền <strong>Chi nhánh</strong>, báo cáo sẽ chỉ bao gồm dữ liệu từ chi nhánh của bạn.
</p>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const branchSelect = document.getElementById('branchSelect');
            const nhanVienSelect = document.getElementById('nhanVienSelect');

            if (branchSelect) {
                branchSelect.addEventListener('change', function () {
                    const branch = this.value;
                    nhanVienSelect.innerHTML = '<option value="">-- Đang tải... --</option>';

                    if (!branch) {
                        nhanVienSelect.innerHTML = '<option value="">-- Chọn nhân viên --</option>';
                        return;
                    }

                    fetch(`?handler=NhanViens&branch=${branch}`)
                        .then(response => response.json())
                        .then(data => {
                            nhanVienSelect.innerHTML = '<option value="">-- Chọn nhân viên --</option>';
                            data.forEach(item => {
                                const option = document.createElement('option');
                                option.value = item.value;
                                option.textContent = item.text;
                                nhanVienSelect.appendChild(option);
                            });
                        })
                        .catch(error => {
                            console.error('Lỗi khi tải danh sách nhân viên:', error);
                            nhanVienSelect.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
                        });
                });
            }

            const exportForm = document.getElementById('exportForm');
            if (exportForm) {
                exportForm.addEventListener('submit', function (e) {
                    e.preventDefault(); // Ngăn form submit theo cách thông thường

                    const formData = new FormData(exportForm);
                    const params = new URLSearchParams(formData);
                    window.location.href = `?handler=ExportActivity&${params.toString()}`;
                });
            }
        });
    </script>
}