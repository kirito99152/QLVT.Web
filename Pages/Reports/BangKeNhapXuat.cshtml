@page
@model QLVT.Web.Pages.Reports.BangKeNhapXuatModel
@{
    ViewData["Title"] = "Bảng kê chi tiết Nhập/Xuất";
}

<h1>@ViewData["Title"]</h1>

<form method="get">
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label>Loại phiếu</label>
                <select name="type" class="form-control">
                    <option value="N">Nhập</option>
                    <option value="X">Xuất</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Từ ngày</label>
                <input type="date" name="startDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Now).AddDays(-DateTime.Now.Day + 1).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Đến ngày</label>
                <input type="date" name="endDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-3 align-self-end">
            <div class="form-group">
                <button type="submit" class="btn btn-success" asp-page-handler="Export">Xuất Excel</button>
            </div>
        </div>
    </div>
</form>

<p class="mt-3">
    <strong>Lưu ý:</strong> Báo cáo này sẽ được xuất trực tiếp ra file Excel. <br/>
    - Nếu bạn đăng nhập với quyền <strong>Công ty</strong>, báo cáo sẽ tổng hợp dữ liệu từ cả 2 chi nhánh. <br/>
    - Nếu bạn đăng nhập với quyền <strong>Chi nhánh</strong> hoặc <strong>User</strong>, báo cáo sẽ chỉ bao gồm dữ liệu từ chi nhánh của bạn.
</p>

@if (TempData["ReportMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["ReportMessage"]
    </div>
}