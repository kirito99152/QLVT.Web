@page "{id}"
@model QLVT.Web.Pages.System.EditUserRoleModel
@{
    ViewData["Title"] = "Sửa vai trò người dùng";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Input.UserId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input asp-for="Input.UserName" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Vai trò</label>
                <div class="form-check">
                    @foreach (var role in Model.AllRoles)
                    {
                        <div class="mb-2">
                            <input type="checkbox" name="Input.SelectedRoles" value="@role.Name"
                                   @(Model.Input.SelectedRoles.Contains(role.Name!) ? "checked" : "") />
                            <label>@role.Name</label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-page="./ManageAccounts" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>