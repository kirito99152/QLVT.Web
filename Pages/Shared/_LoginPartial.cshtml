@using Microsoft.AspNetCore.Identity
@using QLVT.Web.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
        var roleName = roles.FirstOrDefault() ?? "Unknown";
        var branch = user?.BranchCode ?? User.FindFirst("CurrentBranch")?.Value ?? "CN1";

        <li class="nav-item">
            <span class="nav-link text-dark">
                Xin chào, @user!.UserName (@roleName - @branch)
            </span>
        </li>

        @* Công Ty thấy link chọn chi nhánh *@
        @if (User.IsInRole("CongTy"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-page="/Branches/Switch">Đổi chi nhánh</a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn btn-link nav-link text-dark">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Login">Đăng nhập</a>
        </li>
    }
</ul>